{
  "name": "langchain-playground",
  "private": true,
  "workspaces": [
    "admin-web",
    "front-web",
    "server"
  ],
  "scripts": {
    "dev:front": "npm run dev --workspace=front-web",
    "dev:admin": "npm run dev --workspace=admin-web",
    "dev:server": "npm run start:dev --workspace=server",
    "dev": "npx concurrently --kill-others --names front,admin,server --prefix-colors cyan,magenta,yellow \"npm run dev:front\" \"npm run dev:admin\" \"npm run dev:server\"",
    "build": "npm run build --workspaces --if-present",
    "build:front": "npm run build --workspace=front-web",
    "build:admin": "npm run build --workspace=admin-web",
    "build:server": "npm run build --workspace=server",
    "lint": "npm run lint --workspaces --if-present",
    "lint:front": "npm run lint --workspace=front-web",
    "lint:admin": "npm run lint --workspace=admin-web",
    "lint:server": "npm run lint --workspace=server",
    "test": "npm run test --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "lerna": "^8.2.2"
  }
}
